# Production settings for the EC2 deployment. Copy to .env.prod on the server (cp .env.prod.example .env.prod; chmod 600 .env.prod).
# NEVER commit .env.prod. Compose reads it twice: for ${VAR} interpolation (--env-file) and as the containers' environment.
# Values are NOT quoted. Do not put spaces around "=".

# --- Host --------------------------------------------------------------------------------------------------------------
# Public hostname Caddy gets a certificate for. sslip.io maps dashes to an IP: Elastic IP 13.201.45.67 -> 13-201-45-67.sslip.io
DOMAIN=13-201-45-67.sslip.io
# Set by docker-compose.prod.yml, shown for completeness: APP_ENV=production turns on the startup checks (the app refuses to
# start with a default JWT_SECRET / DB password / COOKIE_SECURE=false) and stops it creating the S3 bucket.
# CORS_ORIGINS is also derived there from DOMAIN (["https://<DOMAIN>"]); UI and API share one origin, so CORS is not used.

# --- Database (Postgres 16 + pgvector, inside compose; no published port) ----------------------------------------------
# Generate: openssl rand -hex 24      (hex only: it goes into the URL below unescaped)
# Only read when the volume is first created. Changing it later does NOT change an existing database's password.
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
# Must contain the same password. Host is the compose service name "postgres".
DATABASE_URL=postgresql+psycopg://svs:REPLACE_WITH_openssl_rand_hex_24@postgres:5432/svs

# --- Redis (Celery broker, rate limits, embedding cache, chat memory; no published port) -------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth --------------------------------------------------------------------------------------------------------------
# Generate: openssl rand -base64 48 | tr -d '\n='      (32+ chars required)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Required true in production: the site is served over HTTPS (the app refuses to start otherwise).
COOKIE_SECURE=true

# --- Storage: AWS S3 (private bucket) ----------------------------------------------------------------------------------
# The bucket must already exist, in AWS_REGION, with Block Public Access ON. The app never creates it in production.
S3_BUCKET=REPLACE_WITH_your-bucket-name
AWS_REGION=ap-south-1
# Credentials come from the EC2 instance role (default boto3 chain). Do NOT set S3_ENDPOINT, S3_PUBLIC_ENDPOINT,
# S3_ACCESS_KEY or S3_SECRET_KEY here: compose blanks them, and blank means "real AWS S3 + instance role".

# --- LLM (Gemini) ------------------------------------------------------------------------------------------------------
GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY
# pin an exact model id for reproducible answers
LLM_MODEL=gemini-flash-latest
# per attempt
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=2
# includes thinking tokens
LLM_MAX_OUTPUT_TOKENS=2048
# per user and UTC day; 0 disables. Caps your Gemini bill.
DAILY_TOKEN_BUDGET=200000

# --- ML models (baked into the image at build time: after changing WHISPER_SIZE or EMBED_MODEL, rebuild) ---------------------
# tiny | base | small ... "small" needs more RAM than a 4 GB instance comfortably has next to the API.
WHISPER_SIZE=base
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# must match VECTOR(384) in db/init.sql
EMBED_DIM=384
CHUNK_SECONDS=30
CHUNK_OVERLAP=5

# --- Uploads -----------------------------------------------------------------------------------------------------------
# One value drives the backend check, the Caddy body limit and the UI's client-side check.
MAX_UPLOAD_MB=500

# --- Rate limits (per minute) ------------------------------------------------------------------------------------------
# per client IP + email
RATE_LOGIN_PER_MIN=5
# per user
RATE_SEARCH_PER_MIN=30
# per user
RATE_ASK_PER_MIN=10

# --- Search ------------------------------------------------------------------------------------------------------------
MIN_SCORE=0.25
HYBRID_CANDIDATES=30
RRF_K=60
# true downloads RERANK_MODEL at first use (not baked into the image)
RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
EMBED_CACHE_TTL_SEC=86400
RAG_TOP_K=8

# --- Agent / chat ------------------------------------------------------------------------------------------------------
AGENT_MAX_STEPS=6
AGENT_MAX_LLM_CALLS=8
AGENT_TOOL_RESULT_TOKENS=1500
CHAT_MEMORY_TURNS=3
CHAT_MEMORY_TTL_SEC=3600
SSE_KEEPALIVE_SEC=15

# --- Optional: gunicorn workers in the api container (default 2; each loads the embedding model, ~0.5 GB) -----------------
# WEB_CONCURRENCY=2
