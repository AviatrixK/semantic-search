# Production settings for the EC2 deployment. Copy to .env.prod on the server (cp .env.prod.example .env.prod; chmod 600 .env.prod).
# NEVER commit .env.prod. Compose reads it twice: for ${VAR} interpolation (--env-file) and as the containers' environment.
# Values are NOT quoted. Do not put spaces around "=".

# --- Host --------------------------------------------------------------------------------------------------------------
# Public hostname Caddy gets a certificate for. sslip.io maps dashes to an IP: Elastic IP 13.201.45.67 -> 13-201-45-67.sslip.io
DOMAIN=13-201-45-67.sslip.io
# Set by docker-compose.prod.yml, shown for completeness: APP_ENV=production turns on the startup checks (the app refuses to
# start with a default JWT_SECRET / DB password / COOKIE_SECURE=false) and stops it creating the S3 bucket.
# CORS_ORIGINS is also derived there from DOMAIN (["https://<DOMAIN>"]); UI and API share one origin, so CORS is not used.

# --- Database (Postgres 16 + pgvector, inside compose; no published port) ----------------------------------------------
# Generate: openssl rand -hex 24      (hex only: it goes into the URL below unescaped)
# Only read when the volume is first created. Changing it later does NOT change an existing database's password.
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
# Must contain the same password. Host is the compose service name "postgres".
DATABASE_URL=postgresql+psycopg://svs:REPLACE_WITH_openssl_rand_hex_24@postgres:5432/svs

# --- Redis (Celery broker, rate limits, embedding cache, chat memory; no published port) -------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth --------------------------------------------------------------------------------------------------------------
# Generate: openssl rand -base64 48 | tr -d '\n='      (32+ chars required)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Required true in production: the site is served over HTTPS (the app refuses to start otherwise).
COOKIE_SECURE=true

# --- Storage: AWS S3 (private bucket) ----------------------------------------------------------------------------------
# The bucket must already exist, in AWS_REGION, with Block Public Access ON. The app never creates it in production.
S3_BUCKET=REPLACE_WITH_your-bucket-name
AWS_REGION=ap-south-1
# Credentials come from the EC2 instance role (default boto3 chain). Do NOT set S3_ENDPOINT, S3_PUBLIC_ENDPOINT,
# S3_ACCESS_KEY or S3_SECRET_KEY here: compose blanks them, and blank means "real AWS S3 + instance role".

# --- ML models (baked into the image at build time: after changing WHISPER_SIZE or EMBED_MODEL, rebuild) ---------------------
# tiny | base | small ... "small" needs more RAM than a 4 GB instance comfortably has next to the API.
WHISPER_SIZE=base
# CPU threads the worker may use while it processes a video. 1 keeps one of the two CPUs free so search stays fast during a
# transcription; raise both (e.g. 2) on a bigger instance if uploads should finish sooner. Read at runtime: no rebuild needed.
# WORKER ONLY: the api container sees these lines but never applies them (it needs every CPU for query embedding).
WHISPER_THREADS=1
TORCH_THREADS=1
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# must match VECTOR(384) in db/init.sql
EMBED_DIM=384
CHUNK_SECONDS=30
CHUNK_OVERLAP=5

# --- Uploads -----------------------------------------------------------------------------------------------------------
# One value drives the backend check, the Caddy body limit and the UI's client-side check.
MAX_UPLOAD_MB=500

# --- Rate limits (per minute) ------------------------------------------------------------------------------------------
# per client IP + email
RATE_LOGIN_PER_MIN=5
# per user
RATE_SEARCH_PER_MIN=30

# --- Search ------------------------------------------------------------------------------------------------------------
MIN_SCORE=0.25
# Cosine similarities are spread differently by every embedding model, so a hit's cut-off can be set per provider. Leave a line empty
# to use MIN_SCORE. 0.25 was tuned for the local MiniLM model; the hosted models' values are NOT measured yet: run
# eval/run_provider_eval.py with your queries, then raise a value if weak matches show up, lower it if good ones go missing.
MIN_SCORE_LOCAL=
MIN_SCORE_GEMINI=
MIN_SCORE_COHERE=
MIN_SCORE_OPENAI=
HYBRID_CANDIDATES=30
RRF_K=60
# true downloads RERANK_MODEL at first use (not baked into the image)
RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
# cached query embeddings: key = provider + model + dimensions + query (7 days)
EMBED_CACHE_TTL_SEC=604800

# --- Hosted models (optional). The defaults below keep the local models: nothing changes until you switch -----------------
# Transcription: whisper (local) | sarvam (Saaras via Sarvam's batch API: needs SARVAM_API_KEY).
# Sarvam transcribes each video ONCE (INR 30 per hour of audio, native script). The romanised (roman) and English (en) text of every
# chunk are then made from that native text by Sarvam's /transliterate and /translate APIs, INR 20 per 10K characters EACH, which is
# the bigger part of the bill (about INR 312 per hour of video for both, 78,000 characters/hour measured). SARVAM_TEXT_VARIANTS picks
# which to make: "roman,en" (both), "en", "roman" or empty (native only: INR 30/h).
TRANSCRIBER=whisper
SARVAM_API_KEY=
# saaras:v4 is Sarvam's current model, v3 the previous one. With v4, a language in SARVAM_V4_UNSUPPORTED (none per the docs) or one the
# API refuses with 400/422 is transcribed with SARVAM_FALLBACK_MODEL automatically.
SARVAM_MODEL=saaras:v3
SARVAM_FALLBACK_MODEL=saaras:v3
SARVAM_V4_UNSUPPORTED=
SARVAM_TEXT_VARIANTS=roman,en
# sarvam-translate:v1 (23 languages, 2000 characters per request) or mayura:v1 (11 languages, 1000)
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# Embeddings: local | gemini | cohere | openai. Vectors of hosted providers are stored per model in chunk_embeddings; EMBED_DIMENSIONS
# is their size (at most 2000, pgvector's HNSW limit). The key of the chosen provider is required: startup fails without it.
EMBED_PROVIDER=local
EMBED_DIMENSIONS=1536
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-2
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v5.0-pro
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-large
# A search query's embedding gets this long (and one retry); if the provider is still unreachable the search runs on keywords only.
EMBED_QUERY_TIMEOUT_SEC=2
EMBED_QUERY_RETRIES=1
# per request while embedding a video's chunks
EMBED_DOC_TIMEOUT_SEC=30

# --- Live job updates (GET /api/jobs/events, admin page) -----------------------------------------------------------------
# seconds between keep-alive comments on an idle stream, so proxies do not close it
SSE_KEEPALIVE_SEC=15

# --- Logging: api, worker and beat all write to stdout (read with `make logs`); Docker rotates the files (10 MB x 3) --------
# DEBUG | INFO | WARNING | ERROR | CRITICAL. INFO shows startup, warm-up, job progress and upload events.
LOG_LEVEL=INFO

# --- Optional: gunicorn workers in the api container (default 2; each loads the embedding model, ~0.5 GB) -----------------
# WEB_CONCURRENCY=2
