# Copy to .env  (cp .env.example .env)
# Hostnames below are Docker service names. If running the API outside Docker, use localhost.
DATABASE_URL=postgresql+psycopg://svs:svs@postgres:5432/svs
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Local storage is SeaweedFS (compose service still named "minio"); it accepts any credentials in dev.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=videos
# Only used with real AWS S3 (production sets ap-south-1). SeaweedFS accepts anything; keep the value it was always given.
AWS_REGION=us-east-1

CORS_ORIGINS=["http://localhost:5173"]

WHISPER_SIZE=base
# CPU threads for the worker (transcription / embedding). 1 leaves the rest of the machine free for the API.
WHISPER_THREADS=1
TORCH_THREADS=1
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
CHUNK_SECONDS=30
CHUNK_OVERLAP=5
MAX_UPLOAD_MB=500
RATE_LOGIN_PER_MIN=5
RATE_SEARCH_PER_MIN=30
MIN_SCORE=0.25
# Cosine similarities are spread differently by every embedding model, so a hit's cut-off can be set per provider. Leave a line empty
# to use MIN_SCORE. 0.25 was tuned for the local MiniLM model; the hosted models' values are NOT measured yet: run
# eval/run_provider_eval.py with your queries, then raise a value if weak matches show up, lower it if good ones go missing.
MIN_SCORE_LOCAL=
MIN_SCORE_GEMINI=
MIN_SCORE_COHERE=
MIN_SCORE_OPENAI=
HYBRID_CANDIDATES=30
RRF_K=60
RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
# cached query embeddings (7 days)
EMBED_CACHE_TTL_SEC=604800

# --- Hosted models (optional). The defaults below keep the local models: nothing changes until you switch -----------------
# Transcription: whisper (local) | sarvam (Saaras via Sarvam's batch API: needs SARVAM_API_KEY).
# Sarvam transcribes each video ONCE (INR 30 per hour of audio, native script). The romanised (roman) and English (en) text of every
# chunk are then made from that native text by Sarvam's /transliterate and /translate APIs, INR 20 per 10K characters EACH, which is
# the bigger part of the bill (about INR 312 per hour of video for both, 78,000 characters/hour measured). SARVAM_TEXT_VARIANTS picks
# which to make: "roman,en" (both), "en", "roman" or empty (native only: INR 30/h).
TRANSCRIBER=whisper
SARVAM_API_KEY=
# saaras:v4 is Sarvam's current model, v3 the previous one. With v4, a language in SARVAM_V4_UNSUPPORTED (none per the docs) or one the
# API refuses with 400/422 is transcribed with SARVAM_FALLBACK_MODEL automatically.
SARVAM_MODEL=saaras:v3
SARVAM_FALLBACK_MODEL=saaras:v3
SARVAM_V4_UNSUPPORTED=
SARVAM_TEXT_VARIANTS=roman,en
# sarvam-translate:v1 (23 languages, 2000 characters per request) or mayura:v1 (11 languages, 1000)
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# Embeddings: local | gemini | cohere | openai. Vectors of hosted providers are stored per model in chunk_embeddings; EMBED_DIMENSIONS
# is their size (at most 2000, pgvector's HNSW limit). The key of the chosen provider is required: startup fails without it.
EMBED_PROVIDER=local
EMBED_DIMENSIONS=1536
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-2
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v5.0-pro
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-large
# A search query's embedding gets this long (and one retry); if the provider is still unreachable the search runs on keywords only.
EMBED_QUERY_TIMEOUT_SEC=2
EMBED_QUERY_RETRIES=1
# per request while embedding a video's chunks
EMBED_DOC_TIMEOUT_SEC=30
SSE_KEEPALIVE_SEC=15

# DEBUG | INFO | WARNING | ERROR | CRITICAL (api, worker, beat)
LOG_LEVEL=INFO
