# Copy to .env  (cp .env.example .env)
# Hostnames below are Docker service names. If running the API outside Docker, use localhost.
DATABASE_URL=postgresql+psycopg://svs:svs@postgres:5432/svs
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Local storage is SeaweedFS (compose service still named "minio"); it accepts any credentials in dev.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=videos
# Only used with real AWS S3 (production sets ap-south-1). SeaweedFS accepts anything; keep the value it was always given.
AWS_REGION=us-east-1

CORS_ORIGINS=["http://localhost:5173"]

WHISPER_SIZE=base
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
CHUNK_SECONDS=30
CHUNK_OVERLAP=5
MAX_UPLOAD_MB=500
RATE_LOGIN_PER_MIN=5
RATE_SEARCH_PER_MIN=30
RATE_ASK_PER_MIN=10
MIN_SCORE=0.25
HYBRID_CANDIDATES=30
RRF_K=60
RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
EMBED_CACHE_TTL_SEC=86400
LLM_MODEL=gemini-flash-latest
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048
RAG_TOP_K=8
AGENT_MAX_STEPS=6
AGENT_MAX_LLM_CALLS=8
AGENT_TOOL_RESULT_TOKENS=1500
DAILY_TOKEN_BUDGET=200000
CHAT_MEMORY_TURNS=3
CHAT_MEMORY_TTL_SEC=3600
SSE_KEEPALIVE_SEC=15
GEMINI_API_KEY=
